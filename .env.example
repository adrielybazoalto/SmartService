# ============================================
# SmartService — variables de entorno
# Copia este archivo a `.env.local` y completa los valores.
# NUNCA subas `.env.local` (ya está en .gitignore).
# ============================================

# --- Supabase (SOLO base de datos) ---
# URL del proyecto (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Service role key (Settings → API, solo servidor. ¡Nunca exponer al cliente!)
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth de la aplicación (bcryptjs + JWT) ---
# Secreto para firmar la cookie de sesión. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# --- Stripe (Pagos) ---
# Secret key (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=
# Webhook signing secret (Dashboard → Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=

# --- OpenAI (Asistente IA) ---
OPENAI_API_KEY=